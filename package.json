{
  "name": "faststationbox",
  "productName": "FastStationBox",
  "version": "1.3.0",
  "private": true,
  "description": "A controller-first desktop game library.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "web": "node server.cjs",
    "check": "node --check app.js && node --check library-backup.js && node --check steam-library.js && node --check electron/steam-discovery.cjs && node --check electron/local-discovery.cjs && node --check electron/main.cjs && node --check electron/preload.cjs && node --check server.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "electron tests/library-backup-ui.cjs",
    "test:xboxone": "electron tests/xboxone-ui.cjs",
    "test:xboxseries": "electron tests/xboxseries-ui.cjs",
    "pack": "electron-builder --dir",
    "dist": "node scripts/build-win.cjs nsis",
    "dist:portable": "node scripts/build-win.cjs portable"
  },
  "build": {
    "appId": "com.faststationbox.launcher",
    "productName": "FastStationBox",
    "asar": true,
    "files": [
      "app.js",
      "library-backup.js",
      "steam-library.js",
      "index.html",
      "styles.css",
      "server.cjs",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FastStationBox",
      "differentialPackage": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@node-steam/vdf": "^2.2.0",
    "string-argv": "^0.4.0"
  }
}
